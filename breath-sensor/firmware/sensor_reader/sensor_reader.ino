// =============================================================================
//  sensor_reader.ino — Air-Rhythm 호흡 인장 센서 리더 (ESP32-WROOM-32)
// =============================================================================
//  요구사항 대응
//    FR-01  : 50 Hz 주기 측정 + 내부 풀업 활성화 + 115200 bps 시리얼 전송
//    NFR-안정성: 오버샘플링(채널 노이즈) + 이동 평균(움직임/접촉 노이즈)
//
//  회로 (외부 저항 없음)
//
//      3.3V ──[ 내부 풀업 ~45kΩ ]──┬── GPIO32 (ADC1_CH4)
//                                  │
//                           [ 인장 센서 Rs ]
//                                  │
//                                 GND
//
//      V_pin = 3.3V × Rs / (Rs + R_pu)
//      → 센서 한쪽 끝은 GPIO32, 다른 끝은 GND. 3.3V 핀은 쓰지 않는다.
//
//  Arduino-ESP32 코어 2.x / 3.x 모두 지원 (sensor_app.cpp 의 'ADC + 내부 풀업' 절 참고)
//
//  ⚠ 핀 선택 주의 (WROOM-32 한정)
//    - GPIO34~39 는 입력 전용이며 "내부 풀업/풀다운 회로가 아예 없다".
//      여기에 꽂으면 코드가 맞아도 핀이 떠서(floating) 값이 무작위로 흔들린다.
//    - ADC2(GPIO0,2,4,12~15,25~27) 는 WiFi/BLE 사용 중 읽기가 실패한다.
//      → 나중에 BLE 를 붙일 것이므로 ADC1 이면서 풀업이 있는 GPIO32/33 만 허용.
//
//  출력 형식 (TAB 구분, 한 줄 = 한 샘플)
//      seq  t_ms  mv  ma_mv
//      seq   : 0부터 증가하는 일련번호 → 호스트가 유실 샘플을 셀 수 있음
//      t_ms  : 기기 시각 → 호스트(USB) 도착 지터와 무관한 정확한 시간축
//      mv    : 오버샘플링 평균 전압 (eFuse 보정 적용, mV)
//      ma_mv : 이동 평균 필터 출력 (mV)
//    '#' 로 시작하는 줄은 진단/경고 메시지 (호스트가 데이터와 분리해 처리)
//
//  파일 구성
//    sensor_reader.ino : 진입점 (setup/loop 만)
//    sensor_app.h/.cpp : 실제 구현 — 설정값(cfg::)을 바꾸려면 sensor_app.cpp 를 연다
//    세 파일이 반드시 같은 폴더(sensor_reader/)에 있어야 한다.
// =============================================================================

#include "sensor_app.h"

void setup() {
  sensorAppBegin();
}

void loop() {
  // 모든 작업은 senseTask 가 담당. loop 태스크는 CPU 를 양보만 한다.
  vTaskDelay(portMAX_DELAY);
}
